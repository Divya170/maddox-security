# NestJS API
PORT=4000
# SQLite file (relative to backend/). DATABASE_URL=sqlite:../database/app.sqlite also works.
DATABASE_PATH=../database/app.sqlite
CORS_ORIGIN=http://localhost:3000

# Admin sessions (HttpOnly cookie + CSRF token). Change in production!
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
# Cookies are Secure automatically when NODE_ENV=production; force with COOKIE_SECURE=true/false
COOKIE_SECURE=

# Seeded on first boot only (when no admin exists)
ADMIN_EMAIL=admin@maddoxsecurity.local
ADMIN_PASSWORD=MaddoxAdmin#2026
ADMIN_NAME=Chase Maddox

# Enquiry + application rate limit per IP (default: 5 per 10 minutes)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# "Today" for vacancy closing dates
BUSINESS_TZ=America/New_York

# Folders (relative to backend/). Résumés are private and never served publicly.
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads/resumes

# Retention: delete archived/responded enquiries and unsuccessful/archived applications
# (with their résumés) N months after they were closed. 0 = keep (owner to decide).
RETENTION_MONTHS=0

# Optional staff emails for each new enquiry/application (sent after the DB commit,
# enquiries retried up to 5 times). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM="Maddox Security Services Website <no-reply@example.com>"
# Recipients; default to the business email in Admin → Settings when empty
NOTIFY_TO=
CAREERS_NOTIFY_TO=
ADMIN_URL=http://localhost:3000/admin
